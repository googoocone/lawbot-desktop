# 기존 Next.js 프로젝트의 .env에서 그대로 복사하시면 됩니다.
# Supabase 대시보드 > Settings > API 에서 확인 가능합니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# 중앙 크롤링 서버 (lawbot-crawler)
# 인증은 로그인한 Supabase 세션 토큰(JWT)으로 하므로 별도 시크릿이 필요 없다.
VITE_CRAWLER_URL=https://crawler.law-bot-api.com
